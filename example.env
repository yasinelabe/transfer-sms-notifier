# Oracle (same as autosupport)
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_CONN_STRING=host:1521/service_name

# MySQL state
MYSQL_DSN=user:password@tcp(localhost:3306)/transfer_sms?parseTime=true

# Polling
POLL_INTERVAL_SECONDS=30
POLL_BATCH_SIZE=100
PROCESS_ON_FIRST_POLL=false

# SMS master switch — false = dry-run (poll + log + DB, no smsbulk)
SMS_SENDING_ENABLED=false

# Audience
SEND_TO_RECEIVERS=true
SEND_TO_SENDERS=true

# Receiver SMS (header max 11 chars)
RECEIVER_SMS_HEADER=Telesom
RECEIVER_SMS_CONTENT=You received transfer {{transferId}} from {{sender}}.

# Sender SMS
SENDER_SMS_HEADER=Telesom
SENDER_SMS_CONTENT=You sent transfer {{transferId}} to {{receiver}}.

# smsbulk outbound (required when SMS_SENDING_ENABLED=true)
SMS_CLIENT_ID=transfer_notifier
SMSBULK_BASE_URL=http://localhost:8080
SMSBULK_API_KEY=change-me
